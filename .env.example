# API NestJS Athena (le backend qu'on garde)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Origine de la PWA (liens de partage absolus + metadataBase OG).
# Prod : https://athena-app.xyz
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Auth (projet open-athena) — repris de l'existant
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web Push (VAPID) — générer avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@athena.app

# PostHog (analytics produit, Cloud EU). Token PUBLIC projet (visible côté client,
# pas un secret). Servi via reverse-proxy /ingest (cf. next.config.ts).
# ⚠️ NEXT_PUBLIC_* est figé au BUILD → si tu le définis, ce doit être dans les App
# Configs CapRover (le Dockerfile le passe en --build-arg), pas au runtime.
# Optionnel pour la prod athena-app.xyz : `instrumentation-client.ts` retombe sur le
# token du projet Athena pour ce seul hôte. Obligatoire pour tout autre déploiement.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
